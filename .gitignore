# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
.supabase
supabase/.temp/
supabase/functions/

# dev tooling
.playwright-mcp/
claudedocs/
CLAUDE.md
**/CLAUDE.md
.serena/
.claude/settings.json

# design-sync build artifacts
.ds-sync/
ds-bundle/
.design-sync/

# test screenshots (playwright/browser verification artifacts)
*.png
*.jpeg
*.jpg

# favicon/app icons/브랜드 로고 (실제 자산 - 위 스크린샷 무시 규칙에서 예외)
!src/app/icon.png
!src/app/apple-icon.png
!public/brand/
!public/brand/*.png

# 제품소개/교육자료 제작용 임시 산출물 (데모 계정 정보 포함, 커밋 금지)
product-video/

# 대시보드 사용 가이드 실제 자산 (위 스크린샷 무시 규칙에서 예외, public/guide는 실서비스 자산)
!public/guide/
!public/guide/screenshots/
!public/guide/screenshots/*.png
